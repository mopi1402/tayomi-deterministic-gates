{
  "gates": [
    {
      "name": "typecheck",
      "severity": "error",
      "files": "(\\.ts|^tsconfig\\.json)$",
      "run": [
        "typescript",
        "--pretty",
        "false",
        "--incremental",
        "--tsBuildInfoFile",
        "node_modules/.cache/gates/tsbuildinfo"
      ]
    },
    {
      "name": "format",
      "severity": "error",
      "files": "\\.(ts|js|json|md|ya?ml)$",
      "run": ["prettier", "--check", "--log-level", "warn", "--no-error-on-unmatched-pattern", "{files}"]
    },
    {
      "name": "related-node-tests",
      "severity": "error",
      "files": "^src/.*\\.ts$",
      "run": ["{engine}/src/helpers/related-tests.ts", "--require-tests", "--tests", "^src/.*\\.test\\.ts$", "{files}"]
    },
    {
      "name": "integration",
      "severity": "error",
      "files": "^(integration/|catalog/)",
      "run": ["node", "--test", "integration/*.test.ts"]
    },
    {
      "name": "no-new-clones",
      "severity": "error",
      "files": "\\.ts$",
      "run": ["{engine}/src/helpers/new-clones.ts", "{turn}"]
    },
    {
      "name": "no-new-dead-code",
      "severity": "error",
      "files": "(\\.ts|^package\\.json|^knip\\.json)$",
      "run": ["knip", "--reporter", "compact", "--no-exit-code", "--no-progress"],
      "compare": "turn-start",
      "ignoreLines": "\\(\\d+\\)$"
    },
    {
      "name": "no-new-suppressions",
      "severity": "error",
      "files": "^(?!src/helpers/new-suppressions|src/core/report\\.|integration/).*\\.ts$",
      "run": ["{engine}/src/helpers/new-suppressions.ts", "{turn}", "{files}"]
    }
  ]
}
